{
  "expo": {
    "name": "SecOpsDaily",
    "slug": "secopsdaily",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vigil.securityintel"
    },
    "android": {
      "package": "com.vigil.securityintel",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3D5AFE",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11131C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#11131C",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "./plugins/withReleaseBuildSettings",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Outfit_400Regular.ttf",
            "./assets/fonts/Outfit_500Medium.ttf",
            "./assets/fonts/Outfit_600SemiBold.ttf",
            "./assets/fonts/Outfit_700Bold.ttf"
          ]
        }
      ]
    ],
    "scheme": [
      "secopsdaily",
      "vigil"
    ],
    "backgroundColor": "#11131C",
    "experiments": {
      "typedRoutes": false
    }
  }
}
