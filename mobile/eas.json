{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "base": {
      "node": "22.23.4",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com" }
    },
    "development-apk": {
      "extends": "base",
      "distribution": "internal",
      "env": { "APP_VARIANT": "debug" },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "credentialsSource": "remote"
      }
    },
    "release-apk": {
      "extends": "base",
      "distribution": "internal",
      "env": { "APP_VARIANT": "release" },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "extends": "base",
      "env": { "APP_VARIANT": "release" },
      "android": { "buildType": "app-bundle", "credentialsSource": "remote" }
    }
  }
}
