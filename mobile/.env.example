# Copy to .env for local builds (never commit .env). CI sets these from repository variables/secrets.

# debug | release  — selects package id, app name and whether sample data is compiled in
APP_VARIANT=debug
# 1 only for the debug variant: includes fictional sample data (marked DEMO everywhere)
EXPO_PUBLIC_DEMO_MODE=1
# Optional. Server for "server mode". Must be https://. Leave empty for on-device only.
EXPO_PUBLIC_API_BASE_URL=
# Optional, for EAS builds / remote push
EAS_PROJECT_ID=
EAS_OWNER=

# Release signing (see docs/SIGNING.md). Do not put real values in this example file.
PF360_KEYSTORE_PATH=/absolute/path/to/pf360-release.keystore
PF360_KEYSTORE_PASSWORD=
PF360_KEY_ALIAS=pf360
PF360_KEY_PASSWORD=
