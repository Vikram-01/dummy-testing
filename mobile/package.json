{
  "name": "personal-finance-360",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/__tests__/*.test.ts",
    "build:apk:debug": "eas build -p android --profile development-apk",
    "build:apk:release": "eas build -p android --profile release-apk",
    "build:aab": "eas build -p android --profile production",
    "build:local:debug": "eas build -p android --profile development-apk --local",
    "build:local:release": "eas build -p android --profile release-apk --local",
    "test:engine": "node scripts/engine-test/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:engine"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.105.2",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-query-persist-client": "^5.105.2",
    "expo": "58.0.22",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.29",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
