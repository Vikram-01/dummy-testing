PF360_ISSUER=pf360-api
PF360_ACCESS_TTL=900
PF360_REFRESH_TTL=2592000
# true seeds demo@pf360.dev with FICTIONAL data. Set false in production.
PF360_DEMO=true
PF360_DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
